# memory 模式无需安装 MySQL，适合先学习 HTTP、分层和前后端联调。
DB_DRIVER=memory
PORT=3000
WEB_ORIGIN=http://localhost:5173
JWT_SECRET=please-change-this-to-a-random-secret-at-least-32-characters
SEED_DEMO_DATA=true

# 切换成 DB_DRIVER=mysql 后才会读取下面这些值。
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=your-password
MYSQL_DATABASE=miniboard

